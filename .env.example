# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SMTP Email Configuration (Optional - falls back to Interactive Demo Mode if empty)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@internpilot.ai"
SMTP_PASS="your-app-password-or-secret"
SMTP_FROM="InternPilot AI <notifications@internpilot.ai>"
SMTP_SECURE="false"
